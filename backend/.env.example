# Copy this file to .env (same folder) and fill in your values.
# Keep this .env.example file: it shows teammates what to set up.
# .env is ignored by git: never commit a real API key.

# Gemini API key, free from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: which Gemini model to use (default: gemini-3.5-flash-lite, the fastest)
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: model to try if the main one is overloaded (default: gemini-3.1-flash-lite).
# Leave it empty to turn the fallback off.
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Optional: chat messages each user may send per 10 minutes (default: 30)
# CHAT_RATE_LIMIT=30

# Optional: where the Python spending service runs (default: http://127.0.0.1:8000)
# SPENDING_URL=http://127.0.0.1:8000

# Optional: port for this server (default: 3000)
# PORT=3000
